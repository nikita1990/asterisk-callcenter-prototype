<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  Провайдер принимает ИСХОДЯЩИЙ вызов от Asterisk.

  INVITE (без авторизации)      -> 401 WWW-Authenticate
  ACK
  INVITE (с Authorization)      -> проверка digest (verifyauth)
       верно:   180 -> 200 OK + SDP -> ACK -> 6 с G.711 -> BYE
       неверно: 403 Forbidden -> ACK

  Глобальные переменные trunk_user / trunk_pass задаются через -set в entrypoint.sh
-->
<scenario name="carrier UAS: outbound call with digest auth">

  <!-- задаются снаружи через -set -->
  <Global variables="trunk_user,trunk_pass"/>

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="carrier.local", nonce="[pid][call_number]n0nce", algorithm=MD5, qop="auth"
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK"/>

  <recv request="INVITE" rrs="true">
    <action>
      <!-- запоминаем From/To вызова: пригодятся, если BYE пошлём мы -->
      <ereg regexp="^ *(.*)$" search_in="hdr" header="From:" assign_to="junk,caller_from"/>
      <ereg regexp="^ *(.*)$" search_in="hdr" header="To:" assign_to="junk,caller_to"/>
      <verifyauth assign_to="authvalid" username="[$trunk_user]" password="[$trunk_pass]"/>
    </action>
  </recv>

  <nop hide="true" test="authvalid" next="auth_ok"/>

  <!-- неверный логин/пароль -->
  <send>
    <![CDATA[
      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK" next="end"/>

  <label id="auth_ok"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="1000"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=carrier 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=ptime:20
      a=sendrecv

    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <!-- "абонент" говорит: ~8 с записанного G.711a из комплекта SIPp -->
  <nop>
    <action>
      <exec play_pcap_audio="pcap/g711a.pcap"/>
    </action>
  </nop>

  <!-- ждём BYE от вызывающей стороны до 8 с, иначе кладём трубку сами -->
  <recv request="BYE" timeout="8000" ontimeout="callee_bye"/>
  <send next="end">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="callee_bye"/>
  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: [$caller_to];tag=[pid]SIPpTag01[call_number]
      To: [$caller_from]
      [last_Call-ID:]
      CSeq: 1 BYE
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>
  <recv response="200" crlf="true"/>

  <label id="end"/>

  <ResponseTimeRepartition value="10, 20, 50, 100, 200, 500"/>
  <CallLengthRepartition value="1000, 5000, 10000, 20000"/>
</scenario>
