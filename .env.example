# Скопируйте в .env (make up делает это сам, если .env нет)

# --- SIP-транк ---
# IP провайдера (здесь — контейнер carrier)
TRUNK_HOST=172.30.0.20
TRUNK_PORT=5060
TRUNK_USERNAME=demo-trunk
TRUNK_PASSWORD=change-me-trunk
# входящий номер (DID), на который провайдер шлёт вызовы
TRUNK_DID=74951234567
# АОН для исходящих (уходит в P-Asserted-Identity)
OUTBOUND_CALLERID=74951234567

# --- агенты 101-103 ---
AGENT_PASSWORD=change-me-agent

# --- рабочее время для GotoIfTime: время,дни_недели,числа,месяцы[,часовой_пояс] ---
# 24/7 для демо; реальный пример: 09:00-18:00,mon-fri,*,*,Europe/Moscow
OFFICE_HOURS=*,*,*,*
